{
  "manifest_version": 3,
  "name": "Discord Fix — Focus panel",
  "version": "0.1.0",
  "description": "Een lokaal, alleen-lezen overzicht naast Discord.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Discord Fix"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
